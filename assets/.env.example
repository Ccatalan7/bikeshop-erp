SUPABASE_URL=your_supabase_url_here
SUPABASE_SECRET_KEY=

# Zoho Books/Inventory API Configuration
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
ZOHO_ORG_ID=your_zoho_org_id_here
ZOHO_API_DOMAIN=https://www.zohoapis.com

# Veryfi OCR Configuration
VERYFI_CLIENT_ID=your_veryfi_client_id_here
VERYFI_API_KEY=your_veryfi_api_key_here
VERYFI_USERNAME=your_veryfi_username_here

# Gemini AI Configuration
# App runtime no longer reads a local Gemini key.
# Gemini now runs through the Supabase Edge Function `gemini-proxy`
# and the real key must be stored as the Supabase secret `GEMINI_API_KEY`.
# Leave this empty unless you are doing one-off local maintenance scripts.
GEMINI_API_KEY=
