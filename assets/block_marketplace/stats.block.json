{
  "type": "stats",
  "title": "Indicadores",
  "description": "Cifras del taller en una banda: la nota y las reseñas en Google, y las que escribas.",
  "usesCustomEditor": false,
  "category": "Contenido",
  "tags": ["indicadores", "estadísticas", "logros"],
  "version": 1,
  "supportsResponsive": true,
  "defaultData": {
    "eyebrow": "El taller en números",
    "title": "Lo que dicen los ciclistas",
    "subtitle": "",
    "tone": "dark",
    "metrics": [
      {
        "source": "google_rating",
        "value": "",
        "suffix": "★",
        "label": "de nota en Google"
      },
      {
        "source": "google_reviews",
        "value": "",
        "suffix": "",
        "label": "reseñas en Google"
      }
    ]
  },
  "fields": [
    {
      "key": "title",
      "label": "Título",
      "type": "text",
      "defaultValue": "Resultados que nos respaldan"
    },
    {
      "key": "metrics",
      "label": "Indicadores",
