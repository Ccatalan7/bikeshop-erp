      "itemFields": [
        {
          "key": "label",
          "label": "Etiqueta",
          "type": "text",
          "defaultValue": "Indicador"
        },
        {
          "key": "value",
          "label": "Valor",
          "type": "text",
          "defaultValue": "0"
        },
        {
          "key": "suffix",
          "label": "Sufijo",
          "type": "text",
          "defaultValue": "+"
        }
      ]
    }
  ],
  "controlSections": [
    {
      "id": "content",
      "label": "Contenido",
      "fields": ["title", "metrics"]
    }
  ]
}
