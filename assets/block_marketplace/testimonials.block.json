{
  "type": "testimonials",
  "title": "Testimonios",
  "description": "Lo que dicen tus clientes, junto a la nota de la tienda en Google.",
  "usesCustomEditor": false,
  "category": "Social",
  "tags": ["testimonios", "opiniones", "reviews"],
  "version": 1,
  "supportsResponsive": true,
  "defaultData": {
    "eyebrow": "Reseñas en Google",
    "title": "",
    "subtitle": "",
    "showGoogleRating": true,
    "tone": "light",
    "testimonials": []
  },
  "fields": [
    {
      "key": "title",
      "label": "Título",
      "type": "text",
      "group": "content"
    },
    {
      "key": "testimonials",
      "label": "Testimonios",
      "type": "repeater",
      "itemLabel": "Testimonio",
      "minItems": 1,
      "itemFields": [
        {
          "key": "name",
          "label": "Nombre",
          "type": "text",
          "defaultValue": "Nombre"
        },
        {
          "key": "role",
          "label": "Rol",
          "type": "text",
          "defaultValue": "Cliente"
        },
        {
          "key": "comment",
          "label": "Comentario",
          "type": "textarea",
          "defaultValue": "Escribe el testimonio"
        },
        {
          "key": "rating",
          "label": "Valoración",
          "type": "number",
          "min": 1,
          "max": 5,
          "step": 1,
          "defaultValue": 5
        }
      ]
    }
  ],
  "controlSections": [
    {
      "id": "content",
      "label": "Contenido",
      "fields": ["title", "testimonials"]
    }
  ]
}
