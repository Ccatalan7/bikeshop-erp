{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Flutter: Run (Development)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=ENV=development",
        "--dart-define=DEBUG_EMAIL=vinabikechile@gmail.com",
        "--dart-define=DEBUG_PASSWORD=000000"
      ]
    },
    {
      "name": "🌐 Flutter: Run (Web - Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    },
    {
      "name": "👷 Worker Portal (Chrome • Local)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-port=5777",
        "--web-launch-url=http://localhost:5777/",
        "--dart-define=ENV=development",
        "--dart-define=DEBUG_INITIAL_ROUTE=/worker/login"
      ]
    },
    {
      "name": "🐞 Debug Vinabike Store (Chrome)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main_store.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define=STORE_PERF_LOGS=true",
        "--dart-define=PUBLIC_STORE_IGNORE_AUTH=true",
        "--dart-define=PUBLIC_STORE_TENANT_ID=5443b130-cc28-45af-a420-cd500b288890",
        "--dart-define=PUBLIC_STORE_SUBDOMAIN=vinabike"
      ]
    },
    {
      "name": "🧪 Debug Vinabike Store (Chrome • Reset State)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main_store.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define=STORE_PERF_LOGS=true",
        "--dart-define=PUBLIC_STORE_IGNORE_AUTH=true",
        "--dart-define=PUBLIC_STORE_TENANT_ID=5443b130-cc28-45af-a420-cd500b288890",
        "--dart-define=PUBLIC_STORE_SUBDOMAIN=vinabike",
        "--dart-define=PUBLIC_STORE_DEBUG_RESET_LOCAL_STATE=true"
      ]
    },
    {
      "name": "📱 Public Store (Android • Debug • Skia)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_store.dart",
      "toolArgs": [
        "--no-enable-impeller",
        "--dart-define=STORE_PERF_LOGS=true",
        "--dart-define=PUBLIC_STORE_IGNORE_AUTH=true",
        "--dart-define=PUBLIC_STORE_TENANT_ID=5443b130-cc28-45af-a420-cd500b288890",
        "--dart-define=PUBLIC_STORE_SUBDOMAIN=vinabike",
        "--dart-define=PUBLIC_STORE_DEBUG_RESET_LOCAL_STATE=true"
      ],
      "deviceId": "R28M2189XQF"
    },
    {
      "name": "📱 Public Store (Android • Profile • Skia)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main_store.dart",
      "toolArgs": [
        "--no-enable-impeller",
        "--verbose-system-logs",
        "--dart-define=STORE_PERF_LOGS=true",
        "--dart-define=PUBLIC_STORE_IGNORE_AUTH=true",
        "--dart-define=PUBLIC_STORE_TENANT_ID=5443b130-cc28-45af-a420-cd500b288890",
        "--dart-define=PUBLIC_STORE_SUBDOMAIN=vinabike",
        "--dart-define=PUBLIC_STORE_DEBUG_RESET_LOCAL_STATE=true"
      ],
      "deviceId": "R28M2189XQF"
    },
    {
      "name": "📱 Public Store (Android • Profile • Impeller)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main_store.dart",
      "toolArgs": [
        "--enable-impeller",
        "--verbose-system-logs",
        "--dart-define=STORE_PERF_LOGS=true",
        "--dart-define=PUBLIC_STORE_IGNORE_AUTH=true",
        "--dart-define=PUBLIC_STORE_TENANT_ID=5443b130-cc28-45af-a420-cd500b288890",
        "--dart-define=PUBLIC_STORE_SUBDOMAIN=vinabike",
        "--dart-define=PUBLIC_STORE_DEBUG_RESET_LOCAL_STATE=true"
      ],
      "deviceId": "R28M2189XQF"
    },
    {
      "name": "🪟 Flutter: Run (Windows)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows"
    },
    {
      "name": "🍎 Flutter: Run (macOS)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "macos"
    },
    {
      "name": "📱 Flutter: Run (Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "android"
    },
    {
      "name": "⚡ Flutter: Profile Mode",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart"
    },
    {
      "name": "🚢 Flutter: Release Mode",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart"
    },
    {
      "name": "🔧 Flutter: Debug Current File",
      "request": "launch",
      "type": "dart",
      "program": "${file}"
    }
  ]
}
