{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Flutter: Run (Development)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=ENV=development",
        "--dart-define=DEBUG_EMAIL=vinabikechile@gmail.com",
        "--dart-define=DEBUG_PASSWORD=000000"
      ]
    },
    {
      "name": "🌐 Flutter: Run (Web - Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome"
      ]
    },
    {
      "name": "🐞 Debug Vinabike Store (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_store.dart",
      "args": [
        "-d",
        "chrome",
        "--web-port=8080",
        "--dart-define=STORE_PERF_LOGS=true",
        "--dart-define=PUBLIC_STORE_IGNORE_AUTH=true",
        "--dart-define=PUBLIC_STORE_TENANT_ID=5443b130-cc28-45af-a420-cd500b288890",
        "--dart-define=PUBLIC_STORE_SUBDOMAIN=vinabike",
        "--dart-define=PUBLIC_STORE_DEBUG_RESET_LOCAL_STATE=true"
      ]
    },
    {
      "name": "📱 Public Store (Android • Debug • Skia)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_store.dart",
      "args": [
        "--no-enable-impeller",
        "--dart-define=STORE_PERF_LOGS=true",
        "--dart-define=PUBLIC_STORE_IGNORE_AUTH=true",
        "--dart-define=PUBLIC_STORE_TENANT_ID=5443b130-cc28-45af-a420-cd500b288890",
        "--dart-define=PUBLIC_STORE_SUBDOMAIN=vinabike",
        "--dart-define=PUBLIC_STORE_DEBUG_RESET_LOCAL_STATE=true"
      ],
      "deviceId": "R28M2189XQF"
    },
    {
      "name": "📱 Public Store (Android • Profile • Skia)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main_store.dart",
      "args": [
        "--no-enable-impeller",
        "--verbose-system-logs",
        "--dart-define=STORE_PERF_LOGS=true",
        "--dart-define=PUBLIC_STORE_IGNORE_AUTH=true",
        "--dart-define=PUBLIC_STORE_TENANT_ID=5443b130-cc28-45af-a420-cd500b288890",
        "--dart-define=PUBLIC_STORE_SUBDOMAIN=vinabike",
        "--dart-define=PUBLIC_STORE_DEBUG_RESET_LOCAL_STATE=true"
      ],
      "deviceId": "R28M2189XQF"
    },
    {
      "name": "📱 Public Store (Android • Profile • Impeller)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main_store.dart",
      "args": [
        "--enable-impeller",
        "--verbose-system-logs",
        "--dart-define=STORE_PERF_LOGS=true",
        "--dart-define=PUBLIC_STORE_IGNORE_AUTH=true",
        "--dart-define=PUBLIC_STORE_TENANT_ID=5443b130-cc28-45af-a420-cd500b288890",
        "--dart-define=PUBLIC_STORE_SUBDOMAIN=vinabike",
        "--dart-define=PUBLIC_STORE_DEBUG_RESET_LOCAL_STATE=true"
      ],
      "deviceId": "R28M2189XQF"
    },
    {
      "name": "🪟 Flutter: Run (Windows)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "windows"
      ]
    },
    {
      "name": "🍎 Flutter: Run (macOS)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "macos"
      ]
    },
    {
      "name": "📱 Flutter: Run (Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "android"
      ]
    },
    {
      "name": "⚡ Flutter: Profile Mode",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart"
    },
    {
      "name": "🚢 Flutter: Release Mode",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart"
    },
    {
      "name": "🔧 Flutter: Debug Current File",
      "request": "launch",
      "type": "dart",
      "program": "${file}"
    }
  ]
}