{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "🧰 Repair Flutter SDK (macOS)",
			"type": "shell",
			"command": "bash scripts/bootstrap/ensure_flutter_sdk_macos.sh",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "📱 Run Store (Android • Profile • Skia)",
			"type": "shell",
			"command": "flutter run --profile -d R28M2189XQF -t lib/main_store.dart --no-enable-impeller --verbose-system-logs --dart-define=STORE_PERF_LOGS=true --dart-define=PUBLIC_STORE_IGNORE_AUTH=true --dart-define=PUBLIC_STORE_TENANT_ID=5443b130-cc28-45af-a420-cd500b288890 --dart-define=PUBLIC_STORE_SUBDOMAIN=vinabike --dart-define=PUBLIC_STORE_DEBUG_RESET_LOCAL_STATE=true",
			"problemMatcher": []
		},
		{
			"label": "📱 Run Store (Android • Profile • Impeller)",
			"type": "shell",
			"command": "flutter run --profile -d R28M2189XQF -t lib/main_store.dart --enable-impeller --verbose-system-logs --dart-define=STORE_PERF_LOGS=true --dart-define=PUBLIC_STORE_IGNORE_AUTH=true --dart-define=PUBLIC_STORE_TENANT_ID=5443b130-cc28-45af-a420-cd500b288890 --dart-define=PUBLIC_STORE_SUBDOMAIN=vinabike --dart-define=PUBLIC_STORE_DEBUG_RESET_LOCAL_STATE=true",
			"problemMatcher": []
		},
		{
			"label": "📱 Run Store (Android • Debug • Skia)",
			"type": "shell",
			"command": "flutter run -d R28M2189XQF -t lib/main_store.dart --no-enable-impeller --dart-define=PUBLIC_STORE_IGNORE_AUTH=true --dart-define=PUBLIC_STORE_TENANT_ID=5443b130-cc28-45af-a420-cd500b288890 --dart-define=PUBLIC_STORE_SUBDOMAIN=vinabike --dart-define=PUBLIC_STORE_DEBUG_RESET_LOCAL_STATE=true",
			"problemMatcher": []
		},
		{
			"label": "🚀 Deploy to Firebase (Both Sites)",
			"type": "shell",
			"command": "bash scripts/deploy.sh",
			"windows": {
				"command": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "🚀 Deploy to Firebase (Both Sites) [WASM]",
			"type": "shell",
			"command": "bash scripts/deploy.sh --wasm",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "🚀 Publish Windows Update (all changes)",
			"type": "shell",
			"command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish_windows_update.ps1",
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		}
	]
}
