			"command": "flutter run -d R28M2189XQF -t lib/main_store.dart --no-enable-impeller --dart-define=PUBLIC_STORE_IGNORE_AUTH=true --dart-define=PUBLIC_STORE_TENANT_ID=5443b130-cc28-45af-a420-cd500b288890 --dart-define=PUBLIC_STORE_SUBDOMAIN=vinabike --dart-define=PUBLIC_STORE_DEBUG_RESET_LOCAL_STATE=true",
			"problemMatcher": []
