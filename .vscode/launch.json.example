{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Flutter: Run (Development)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=ENV=development",
        "--dart-define=DEBUG_EMAIL=your-email@example.com",
        "--dart-define=DEBUG_PASSWORD=your-password-here"
      ]
    },
    {
      "name": "🌐 Flutter: Run (Web - Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--web-renderer=html",
        "-d",
        "chrome"
      ]
    },
    {
      "name": "🪟 Flutter: Run (Windows)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "windows"
      ]
    }
  ]
}
