# Installed dependencies and generated platform caches must stay local.
# Commit lockfiles instead; every machine should install dependencies from the lockfile.
node_modules/
**/node_modules/
**/.dart_tool/
**/build/
**/Pods/
**/.venv/
**/venv/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
# ⚠️ IMPORTANT: .vscode/launch.json contains DEBUG_EMAIL and DEBUG_PASSWORD
# Use launch.json.example as template, copy to launch.json and add your credentials
.vscode/launch.json

# Local credential and OAuth output artifacts. Keep examples/templates only.
/temp_token_out*
/token_out.txt
/scripts/zoho_import/zoho_tokens.json
/scripts/import_templates/zoho_tokens.json
/scripts/import_templates/.env
/scripts/odoo_import/.env

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
# Local caches produced by standalone Dart/Flutter tooling and CocoaPods.
# These are machine-specific and can contain thousands of analyzer artifacts.
/.dart-tool/
/.dartServer/
/.cocoapods/
/.flutter
.flutter-plugins-dependencies
.flutter-plugins
.pub-cache/
.pub/
/build/
/coverage/
/playwright-report/
/test-results/

# Built from the pinned Univer npm packages before Flutter web builds.
/web/spreadsheet_engine/univer.bundle.js
/web/spreadsheet_engine/univer.bundle.css

# Root one-off analysis/debug outputs (source fixtures belong under test/fixtures).
/all_models.json
/available_models.json
/edit_target*.txt
/*_debug.json
/manual_import_failures.csv
/missing_products_comparison*.csv
/models.json
/one_embedding.json
/patch[0-9]*.js
/query_embedding.json
/rewrite_filters.patch
/temp_*
/veryfi_out*.txt

# One-off source mutators belong in reviewed migrations/commits, not repo root.
/fix_*.py
/old_code*.txt
/patch_menu.sh
/replace_script.py
/update_*.py

# Import/migration scratch probes and generated human reports.
/scripts/import_templates/temp_*
/scripts/odoo_import/*_COMPARISON.txt
/scripts/odoo_import/*_PROGRESS.txt
/scripts/odoo_import/*_READABLE.txt

# Root probes are not maintained tests; real tests live in test/ or supabase/tests/.
/check_*.dart
/clean_pdf_text.py
/get_logs.dart
/inspect_svg.py
/popover_test.dart
/test_*.dart
/test_db.js
/test_db.py

# Local screenshots and diagnostic captures belong outside source control.
/Screenshots vinabikeProject/

# Known generated command/report outputs retained locally when useful.
/analyze_output.txt
/build_log.txt
/build_log_retry.txt
/curl_out.txt
/deploy.log
/flutter_*.log
/import_with_name_matching.log
/scripts/zoho_import/import_output.log

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Sensitive scripts with credentials
/lib/scripts/import_zoho_images.dart

# Zoho Import Scripts - Contains hardcoded credentials, DO NOT COMMIT
scripts/zoho_import/*.py
scripts/zoho_import/*.env
scripts/zoho_import/.env*
scripts/zoho_import/temp_*
