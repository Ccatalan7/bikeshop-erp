scripts/zoho_import/*.csv
scripts/zoho_import/*.log
scripts/zoho_import/zoho_images/
scripts/zoho_import/temp_zoho_images/

# Keep documentation and README
!scripts/zoho_import/README.md
!scripts/zoho_import/.gitkeep
flutter.zip
flutter.zip
flutter/

