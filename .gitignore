# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
# ⚠️ IMPORTANT: .vscode/launch.json contains DEBUG_EMAIL and DEBUG_PASSWORD
# Use launch.json.example as template, copy to launch.json and add your credentials
.vscode/launch.json

# Local credential and OAuth output artifacts. Keep examples/templates only.
/temp_token_out*
/token_out.txt
/scripts/zoho_import/zoho_tokens.json
/scripts/import_templates/zoho_tokens.json
/scripts/import_templates/.env
/scripts/odoo_import/.env

