<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>vb-ERP</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>vinabike_erp</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>NSBluetoothAlwaysUsageDescription</key>
		<string>Esta aplicación necesita acceso a Bluetooth para conectarse a lectores de código de barras</string>
		<key>NSBluetoothPeripheralUsageDescription</key>
		<string>Esta aplicación necesita acceso a Bluetooth para conectarse a lectores de código de barras</string>
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoadsInWebContent</key>
			<true/>
		</dict>
		<key>NSCameraUsageDescription</key>
		<string>Esta aplicación necesita acceso a la cámara para escanear facturas.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Esta aplicación necesita acceso al micrófono para dictar mensajes al asistente.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Esta aplicación necesita acceso a la galería para seleccionar imágenes de facturas.</string>
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>Esta aplicación necesita reconocimiento de voz para convertir tu audio en mensajes para el asistente.</string>
		<!-- La barra de estado del sistema es VISIBLE en iOS (2026-08-03).
		     Estaba oculta, y por eso en iPhone no existía la banda de 47 que
		     `6a` dibuja como parte del header: el usuario no veía reloj, wifi
		     ni batería. Comprobado en un iPhone 17 Pro del simulador con
		     `simctl status_bar override`: la app no los pintaba y la pantalla
		     de inicio del sistema sí, o sea los ocultaba la app. -->
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- El estilo lo decide el view controller, que en Flutter es la UI:
		     así cada pantalla pide el contraste que le corresponde
		     (`SystemChrome.setSystemUIOverlayStyle` / `AnnotatedRegion`). En
		     `false` el contraste queda congelado para toda la app, y esta app
		     tiene pantallas claras y un header navy: ningún valor global sirve
		     para las dos. Éste es el dueño nativo del contraste; no se
		     compensa en cada pantalla. -->
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<true/>
		<!-- Deep link URL scheme for OAuth callbacks -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLName</key>
				<string>com.vinabike.erp</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>vinabike</string>
				</array>
			</dict>
		</array>
	</dict>
</plist>
