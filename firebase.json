{
  "firestore": {
    "rules": "firestore.rules"
  },
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "project-vinabike",
          "configurations": {
            "android": "1:452996097799:android:acfa1afc2da1411e7e47a2",
            "ios": "1:452996097799:ios:9f19dd71884b7dde7e47a2",
            "web": "1:452996097799:web:6af010266020d8ee7e47a2",
            "windows": "1:452996097799:web:859d3944359a5fd27e47a2"
          }
        }
      },
      "android": {
        "default": {
          "projectId": "project-vinabike",
          "appId": "1:452996097799:android:acfa1afc2da1411e7e47a2",
          "fileOutput": "android/app/google-services.json"
        }
      }
    }
  },
  "hosting": [
    {
      "target": "erp",
      "public": "build/web_erp",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.exe"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "store",
      "public": "build/web_store",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.exe"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/productos",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/html; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/productos/**",
