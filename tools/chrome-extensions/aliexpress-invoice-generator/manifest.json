{
  "manifest_version": 3,
  "name": "AliExpress Invoice Generator",
  "version": "0.3.32",
  "description": "Extract visible AliExpress order data and generate an OCR-friendly purchase invoice PDF.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel"],
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://aliexpress.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_title": "Generate AliExpress Invoice",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.aliexpress.com/*", "https://aliexpress.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}