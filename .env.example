# ============================================================
# Bikeshop ERP Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# DO NOT commit your .env file to source control!

# ============================================================
# SUPABASE (Required)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# VERYFI OCR (Optional - for enhanced invoice scanning)
# ============================================================
# Get your API keys at: https://www.veryfi.com/
# Free tier: 100 documents/month
#
# Required for Veryfi cloud OCR:
VERYFI_CLIENT_ID=
VERYFI_API_KEY=

# Optional: Override default API URL (v8 is used by default)
# VERYFI_API_URL=https://api.veryfi.com/api/v8/partner/documents

# Alternative authentication (if your plan uses different headers):
# VERYFI_AUTH_HEADER=Authorization
# VERYFI_AUTH_VALUE=apikey your-client-id:your-api-key

# ============================================================
# Notes:
# ============================================================
# - If VERYFI_CLIENT_ID and VERYFI_API_KEY are empty, the app
#   will use local OCR (Google ML Kit) which works offline.
# - Veryfi provides better accuracy for complex invoices.
# - Local OCR is faster and doesn't require internet.

# ============================================================
# Gemini AI (Required for AI features)
# ============================================================
GEMINI_API_KEY=
