# ============================================================
# Bikeshop ERP Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# DO NOT commit your .env file to source control!

# ============================================================
# SUPABASE PUBLIC CLIENT CONFIGURATION (Required; not privileged)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Flutter compile-time define and local Edge fallback only. Hosted Edge receives
# its named keys through the platform-provided SUPABASE_PUBLISHABLE_KEYS map.
SUPABASE_PUBLISHABLE_KEY=your-modern-publishable-key-here

# Compile-time rollout only. Pass both values with --dart-define; merely adding
# them to a process .env does not switch an already-built application.
AI_AGENT_GATEWAY_ENABLED=false

# ============================================================
# AI AGENT GATEWAY (Server/Edge only; examples, never client secrets)
# ============================================================
# The hosted function receives SUPABASE_PUBLISHABLE_KEYS from the platform and
# keeps every value below in the Edge secret/runtime environment. Do not expose
# these through Flutter --dart-define or commit their real values.
AI_AGENT_FAST_PROVIDER=gemini
AI_AGENT_DEEP_PROVIDER=gemini
AI_AGENT_VISION_PROVIDER=gemini
AI_AGENT_GEMINI_FAST_MODEL=gemini-3.6-flash
AI_AGENT_GEMINI_DEEP_MODEL=gemini-3.1-pro-preview
AI_AGENT_GEMINI_VISION_MODEL=gemini-3.6-flash
AI_AGENT_GEMINI_RESEARCH_MODEL=gemini-3.6-flash
AI_AGENT_GEMINI_RESEARCH_TIMEOUT_MS=65000
# Required when Gemini Google Search is the public-research fallback. Current
# reviewed Google Search grounding price: 14,000 microUSD per reported query.
AI_AGENT_GEMINI_SEARCH_MICROUSD_PER_QUERY=14000
# Alternative provider examples are intentionally omitted here: configure only
# one reviewed provider route and its exact allowlist/pricing in Edge secrets.
# Runtime ledger mutations retain the original caller JWT and add a dedicated
# application-level HMAC attestation. Never reuse the audit HMAC key.
AI_AGENT_RUNTIME_ATTESTATION_KID=
AI_AGENT_RUNTIME_ATTESTATION_KEY_HEX=
AI_AGENT_RUNTIME_ATTESTATION_AUDIENCE=
AI_AGENT_AUDIT_HMAC_KEY=
AI_AGENT_MODEL_PRICING_JSON=

# Browser Use client scaffolding is retained for future deep-navigation work,
# but a key alone does not activate it: the provider must first expose a hard
# read-only action policy and an attestable visited-URL/action trace. Current
# production public research uses forced Gemini Interactions Google Search.
BROWSER_USE_API_KEY=
AI_AGENT_BROWSER_USE_MODEL=bu-max
AI_AGENT_BROWSER_USE_MAX_COST_USD=0.25
AI_AGENT_BROWSER_USE_TIMEOUT_MS=30000

# ============================================================
# VERYFI OCR (Optional - for enhanced invoice scanning)
# ============================================================
# Get your API keys at: https://www.veryfi.com/
# Free tier: 100 documents/month
#
# Required for Veryfi cloud OCR:
VERYFI_CLIENT_ID=
VERYFI_API_KEY=

# Optional: Override default API URL (v8 is used by default)
# VERYFI_API_URL=https://api.veryfi.com/api/v8/partner/documents

# Alternative authentication (if your plan uses different headers):
# VERYFI_AUTH_HEADER=Authorization
# VERYFI_AUTH_VALUE=apikey your-client-id:your-api-key

# ============================================================
# Notes:
# ============================================================
# - If VERYFI_CLIENT_ID and VERYFI_API_KEY are empty, the app
#   will use local OCR (Google ML Kit) which works offline.
# - Veryfi provides better accuracy for complex invoices.
# - Local OCR is faster and doesn't require internet.

# ============================================================
# Gemini AI
# ============================================================
# App runtime no longer reads a local Gemini key.
# Gemini now runs through the Supabase Edge Function `gemini-proxy`
# and the real key must be stored as the Supabase secret `GEMINI_API_KEY`.
# Leave this empty unless you are doing one-off local maintenance scripts.
GEMINI_API_KEY=

# ============================================================
# LOCAL MAINTENANCE / IMPORT TOOLS (Never shipped with the app)
# ============================================================
# Private Supabase credentials do not belong in .env. Store them in the
# operating-system credential store documented in
# docs/development/SUPABASE_WORKFLOW.md, or inject a one-command process
# environment in CI/Windows automation.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCESS_TOKEN=
ODOO_API_KEY=
NOTION_API_KEY=
NOTION_DATABASE_ID=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
ZOHO_IMPORT_SUPABASE_ANON_KEY=
