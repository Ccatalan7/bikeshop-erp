// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = vinabike_erp

// The application's bundle identifier is supplied by the active build
// configuration. Debug must use its own macOS sandbox/container so its
// Supabase session, SharedPreferences, SQLite caches, and WebKit data cannot
// overwrite the installed release app.
PRODUCT_BUNDLE_IDENTIFIER = $(VINABIKE_PRODUCT_BUNDLE_IDENTIFIER)

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2025 com.vinabike. All rights reserved.
