{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vinabike.cl/schemas/catalog-fill-proposal-v1.json",
  "title": "Product specification research proposal (not an apply command)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product_id": {
      "type": "string",
      "format": "uuid"
    },
    "researcher": {
      "enum": [
        "codex",
        "claude"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "review_ready",
        "reviewed",
        "blocked"
      ]
    },
    "based_on": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "spec_revision": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "template_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "contract_version": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "snapshot_sha256",
        "spec_revision",
        "updated_at",
        "template_id",
        "contract_version"
      ]
    },
    "identity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "enum": [
              "brand",
              "model",
              "manufacturer_sku",
              "gtin"
            ]
          },
          "current": {},
          "proposed": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "field",
          "current",
          "proposed",
          "evidence",
          "reason"
        ]
      },
      "minItems": 0
    },
    "reference": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "binding_level": {
              "enum": [
                "model",
                "presentation"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "binding_level",
            "evidence",
            "reason"
          ]
        }
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "current": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {},
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "value",
              "source"
            ]
          },
          "proposed": {
            "type": [
              "string",
              "number",
              "boolean",
              "array"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "reference",
              "research",
              "existing_name"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "current",
          "proposed",
          "unit",
          "method",
          "origin",
          "evidence",
          "scope",
          "reason"
        ]
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "oem_page",
              "oem_catalogue",
              "erp_image",
              "packaging_photo",
              "distributor",
              "name_quote",
              "existing_measurement"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "consulted_on": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "source",
          "locator",
          "consulted_on",
          "scope",
          "finding",
          "sha256"
        ]
      },
      "minItems": 1
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "field",
          "description",
          "evidence",
          "resolution"
        ]
      },
      "minItems": 0
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by": {
          "enum": [
            "codex",
            "claude",
            null
          ]
        },
        "verdict": {
          "enum": [
            "pending",
            "accepted",
            "changes_requested",
            "unresolved"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_proposal_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "by",
        "verdict",
        "date",
        "reviewed_proposal_sha256",
        "notes"
      ]
    }
  },
  "required": [
    "schema_version",
    "product_id",
    "researcher",
    "status",
    "based_on",
    "identity",
    "reference",
    "facts",
    "evidence",
    "conflicts",
    "review"
  ]
}
