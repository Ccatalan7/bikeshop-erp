{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vinabike.cl/schemas/catalog-fill-proposal-v2.json",
  "title": "Exact product specification research proposal (read-only simulation; not an apply command)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "product_id": {
      "type": "string",
      "format": "uuid"
    },
    "researcher": {
      "enum": [
        "codex",
        "claude",
        "claude-peer",
        "owner"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "review_ready",
        "reviewed",
        "blocked"
      ]
    },
    "based_on": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "spec_revision": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "template_id": {
          "type": "string",
          "format": "uuid"
        },
        "contract_version": {
          "type": "integer",
          "minimum": 1
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "fingerprints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "product_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "facts_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "template_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "references_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "product_sha256",
            "facts_sha256",
            "template_sha256",
            "references_sha256"
          ]
        }
      },
      "required": [
        "snapshot_sha256",
        "spec_revision",
        "updated_at",
        "template_id",
        "contract_version",
        "tenant_id",
        "fingerprints"
      ]
    },
    "identity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "enum": [
              "brand",
              "model",
              "manufacturer_sku",
              "gtin"
            ]
          },
          "current": {},
          "proposed": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "field",
          "current",
          "proposed",
          "evidence",
          "reason"
        ]
      },
      "minItems": 0
    },
    "reference": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "binding_level": {
              "enum": [
                "model",
                "presentation"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "binding_level",
            "evidence",
            "reason"
          ]
        }
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "current": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {},
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fact_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "fact_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "confirmed": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "value",
              "source",
              "fact_id",
              "fact_sha256",
              "confirmed"
            ]
          },
          "proposed": {
            "oneOf": [
              {
                "type": [
                  "string",
                  "boolean"
                ]
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schema_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "rows": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "values": {
                          "type": "object",
                          "propertyNames": {
                            "pattern": "^[a-z][a-z0-9_]*$"
                          },
                          "additionalProperties": {
                            "type": [
                              "string",
                              "boolean"
                            ]
                          }
                        },
                        "sources": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "id",
                        "values",
                        "sources"
                      ]
                    }
                  }
                },
                "required": [
                  "schema_version",
                  "rows"
                ]
              }
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "reference",
              "research",
              "existing_name"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "current",
          "proposed",
          "unit",
          "method",
          "origin",
          "evidence",
          "scope",
          "reason"
        ]
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "oem_page",
              "oem_catalogue",
              "erp_image",
              "packaging_photo",
              "distributor",
              "name_quote",
              "existing_measurement"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "consulted_on": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "artifact_path": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "source",
          "locator",
          "consulted_on",
          "scope",
          "finding",
          "sha256",
          "artifact_path"
        ]
      },
      "minItems": 1
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "field",
          "description",
          "evidence",
          "resolution"
        ]
      },
      "minItems": 0
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by": {
          "enum": [
            "codex",
            "claude",
            "claude-peer",
            "owner",
            null
          ]
        },
        "verdict": {
          "enum": [
            "pending",
            "accepted",
            "changes_requested",
            "unresolved"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewed_proposal_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "by",
        "verdict",
        "date",
        "reviewed_proposal_sha256",
        "notes"
      ]
    }
  },
  "required": [
    "schema_version",
    "product_id",
    "researcher",
    "status",
    "based_on",
    "identity",
    "reference",
    "facts",
    "evidence",
    "conflicts",
    "review"
  ],
  "$comment": "v1 remains frozen. v2 binds the authenticated server snapshot and individual observation preimages. Decimal observations are strings. Reviewed hashes cover canonical sorted JSON excluding review."
}
